# Реверс-прокси для домена (вариант HTTP).
# Используется на старте и для прохождения ACME-проверки Let's Encrypt.
# Переменная ${DOMAIN} подставляется из .env через envsubst.
#
# install.sh копирует этот файл (или proxy-ssl.conf.template,
# когда сертификат выпущен) в proxy.conf.template, который
# монтируется в /etc/nginx/templates контейнера proxy.

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    # Проверка домена для Let's Encrypt (certbot webroot)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://site:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
